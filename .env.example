PORT=3000
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=1
COMPRESSION_THRESHOLD_BYTES=1024

# Request rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=60
GENERATION_RATE_LIMIT_WINDOW_MS=900000
GENERATION_RATE_LIMIT_MAX=60
PDF_RATE_LIMIT_WINDOW_MS=900000
PDF_RATE_LIMIT_MAX=30

# Remote database (recommended for shared testing)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# App session JWT (Firebase is used for login identity; this app signs its own session cookie)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=5d

# Firebase Admin (server-only; already configured on Vercel)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web config (safe to expose to the browser through /api/auth/firebase-config)
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_APP_ID=your-firebase-web-app-id
FIREBASE_WEB_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MEASUREMENT_ID=

NODE_ENV=development
