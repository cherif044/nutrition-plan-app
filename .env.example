PORT=3000

# Remote database (recommended for shared testing)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_SSL=true

# Local database fallback (used only when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nutrition_plan
DB_USER=cherif
DB_PASSWORD=your_db_password_here

# Firebase Admin (server-only; already configured on Vercel)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web config (safe to expose to the browser through /api/auth/firebase-config)
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_APP_ID=your-firebase-web-app-id
FIREBASE_WEB_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MEASUREMENT_ID=

# AI meal chat
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_MS=120000

NODE_ENV=development
