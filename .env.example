PORT=3000
SHUTDOWN_TIMEOUT_MS=10000
# Proxies in front of the app whose X-Forwarded-For is trusted. Defaults to 1
# on Vercel and 0 everywhere else; set it only for a known proxy chain.
TRUST_PROXY_HOPS=
COMPRESSION_THRESHOLD_BYTES=1024

# Warm worker pool for CPU-heavy plan generation
GENERATION_WORKER_COUNT=2
GENERATION_MAX_QUEUE=8
GENERATION_TIMEOUT_MS=15000

# Prometheus pull endpoint (/metrics). Off on Vercel (which pushes OTLP)
# unless set to true; production returns 404 unless METRICS_TOKEN is set.
# The token is only accepted as "Authorization: Bearer <token>".
METRICS_ENABLED=
METRICS_TOKEN=replace_with_a_long_random_metrics_token

# Optional: direct metric export for serverless deployments such as Vercel.
# Copy these values from Grafana Cloud's OpenTelemetry connection details.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_METRIC_FLUSH_INTERVAL_MS=5000
OTEL_METRIC_EXPORT_TIMEOUT_MS=3000

# Request rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=60
GENERATION_RATE_LIMIT_WINDOW_MS=900000
GENERATION_RATE_LIMIT_MAX=60
PDF_RATE_LIMIT_WINDOW_MS=900000
PDF_RATE_LIMIT_MAX=30
PLANNER_RATE_LIMIT_MAX=300
PLAN_WRITE_RATE_LIMIT_MAX=300

# Remote database (recommended for shared testing)
# TLS with full certificate checks is always on (set in src/config/database.js);
# any sslmode in this URL is ignored. DB_SSL=false is for a local Postgres only.
DATABASE_URL=postgresql://user:password@host/database
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# App session JWT (Firebase is used for login identity; this app signs its own
# session cookie). At least 32 bytes; production refuses to start with a short
# or placeholder value. Use a different value for Preview and Production.
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
# Key for hashing client IPs in logs and session rows (defaults to JWT_SECRET).
IP_HASH_SECRET=

# Allowed request origins for state-changing API calls. The production origin
# and Vercel deployment URLs are allowed automatically; list extra ones (e.g. a
# custom domain) here, comma-separated.
APP_ORIGIN=https://pincherize.vercel.app
ALLOWED_ORIGINS=

# Hosts that serve the Firebase /__/auth proxy and may be used as authDomain.
FIREBASE_AUTH_DOMAINS=pincherize.vercel.app

# Enforce the strict Content-Security-Policy (no inline script). While unset,
# it is sent as Content-Security-Policy-Report-Only and violations are logged.
CSP_STRICT_ENFORCE=

# Vercel Cron authentication for /api/internal/finish-deletions.
CRON_SECRET=

# Firebase Admin (server-only; already configured on Vercel)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web config (safe to expose to the browser through /api/auth/firebase-config)
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_APP_ID=your-firebase-web-app-id
FIREBASE_WEB_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MEASUREMENT_ID=

NODE_ENV=development
