{
  "name": "nutrition-plan-web",
  "version": "1.0.0",
  "description": "Node.js/Express website version of the Nutrition Plan app.",
  "main": "src/server.js",
  "scripts": {
    "test": "npm run check",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "find src -name '*.js' -exec node --check {} \\; && node --check public/js/app.js && node --check public/js/auth.js && node --check public/js/dashboard.js && node --check public/js/customer.js && node --check public/js/vitals.js && node --check public/js/pagination.js",
    "build:food-swaps": "node scripts/buildFoodSwaps.js",
    "experiment:inspect": "python3 testing_data/scripts/inspect_columns.py",
    "experiment:count": "python3 testing_data/scripts/count_valid_people.py",
    "experiment:sample": "python3 testing_data/scripts/extract_sample.py",
    "sample:people": "python3 testing_data/scripts/extract_sample.py",
    "experiment:generate-plan": "node testing_data/scripts/run_harness.js",
    "benchmark:portion-step": "node testing_data/scripts/benchmark_portion_step.js",
    "compare:step": "node testing_data/scripts/compare_step.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prometheus-io/client": "^0.16.1",
    "@vercel/functions": "^3.9.9",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.21.0",
    "sequelize": "^6.37.8",
    "zod": "^4.6.5",
    "zxcvbn": "^4.4.2"
  },
  "engines": {
    "node": "^22.17 || ^24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "body-parser": "^2.3.0"
  }
}
