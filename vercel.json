{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "data/**",
        "public/**",
        "node_modules/zxcvbn/dist/zxcvbn.js"
      ]
    }
  }
}
